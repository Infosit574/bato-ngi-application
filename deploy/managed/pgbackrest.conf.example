[global]
repo1-type=s3
repo1-s3-endpoint=nbg1.your-objectstorage.com
repo1-s3-region=nbg1
repo1-s3-bucket=example-dev-backup-documentation
repo1-s3-uri-style=path
repo1-path=/example/dev/epoch-1
repo1-s3-key=DOCUMENTATION_ONLY
repo1-s3-key-secret=DOCUMENTATION_ONLY
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_OFFLINE_ESCROWED_RANDOM_PASSPHRASE
repo1-storage-verify-tls=y
repo1-retention-full-type=time
repo1-retention-full=35
repo1-retention-archive-type=full
expire-auto=n
archive-async=n
resume=n
start-fast=y
log-level-console=warn
log-level-file=off
lock-path=/tmp/pgbackrest

[bato]
pg1-path=/var/lib/postgresql/data/pgdata
pg1-socket-path=/var/run/postgresql
